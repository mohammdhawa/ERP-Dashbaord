# Loaded in EVERY mode. Deliberately contains no VITE_API_URL:
# a localhost default here is what put http://localhost:8000/api inside a
# production bundle, where every user's browser then called their own machine.
#
# Dev server  -> .env.development (localhost, committed)
# Production  -> VITE_API_URL must be supplied by the deployment environment.
#                See .env.production.example; vite.config.js fails the build if
#                it is missing or still points at localhost.
NODE_ENV=development
